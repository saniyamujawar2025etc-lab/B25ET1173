#include <iostream>
#include <fstream>
using namespace std;

int main() {
    ifstream fin("source.txt");
    ofstream fout("destination.txt");

    char ch;

    if (!fin) {
        cout << "File cannot be opened";
        return 1;
    }

    while (fin.get(ch)) {
        fout.put(ch);
    }

    cout << "File copied successfully";

    fin.close();
    fout.close();

    return 0;
}
