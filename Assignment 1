#include <iostream>
using namespace std;

int main() {
    int n;

    // Ask the user to enter the number of rows
    cout << "Enter number of rows: ";
    cin >> n;

    // Loop through each row
    for (int i = 0; i < n; i++) {
        // Start with the first value of Pascal's Triangle
        int num = 1;

        // Print spaces before the numbers to create a triangle shape
        for (int space = 0; space < n - i - 1; space++)
            cout << "  ";

        // Print the numbers in the current row
        for (int j = 0; j <= i; j++) {
            cout << num << "   ";

            // Calculate the next number using Pascal's Triangle formula
            num = num * (i - j) / (j + 1);
        }

        // Move to the next line after completing the row
        cout << endl;
    }

    return 0; // End the program
}
