#include <iostream>
#include <cstring>
using namespace std;

// Class named String
class String {
    char str[200]; // Character array to store the sentence

public:

    // Constructor
    String() {
        str[0] = '\0'; // Initialize the string as empty
    }

    // Function to accept a complete sentence
    void Accept() {
        cout << "Enter a sentence: ";
        cin.getline(str, 200); // Read the entire sentence including spaces
    }

    // Function to display the sentence
    void Display() {
        cout << "The sentence is: " << str << endl;
    }

    // Destructor
    ~String() {
        cout << "String object destroyed." << endl;
    }
};

int main() {
    String s;       // Create an object of the String class

    s.Accept();     // Call Accept() to take input
    s.Display();    // Call Display() to display the sentence

    return 0;       // End the program
}


